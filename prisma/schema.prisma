// Prisma schema for gto.today
// Keeps the stock Auth.js v5 model (User/Account/Session/VerificationToken)
// so any official adapter doc applies cleanly. Extra domain tables
// (streaks, solved history) will land in later phases.

generator client {
  provider      = "prisma-client-js"
  // Generate engines for the local OS AND the Linux runtime Vercel
  // uses. Without rhel-openssl-3.0.x, production functions throw
  // 'Query engine not found' at first DB call.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Account lookups and listings are always keyed by userId; without
  // an index Postgres scans the whole table on every session-sync
  // round-trip.
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Auth.js runs an expired-session sweep; indexing `expires` turns
  // that into a range scan instead of a full-table read.
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// 교정지 결정 — dabin.gto.today 등 /proof/[token] 화면이 쓰는 유일한 상태.
//   문서 본문은 코드(app/proof/[token]/doc.ts)에 있고 여기 담기는 건
//   "어느 수정을 적용/취소했나"뿐이라 토큰당 한 행이면 충분하다.
//   원래 Upstash Redis 에 넣으려 했는데 그 DB 가 사라져 있어서(DNS ENOTFOUND)
//   이미 붙어 있고 살아 있는 Neon 으로 옮겼다.
// ⚠️ 이 레포는 prisma/migrations 가 없다. db push 대신 수동 DDL 로 만들었다.
model ProofDecision {
  token     String   @id
  decisions Json
  updatedAt DateTime @updatedAt
}

// 아난티 예약 선점 — ananti.gto.today 가 쓰는 요청 큐.
//   실제 예약 실행은 맥북 launchd 러너(~/bin/ananti-keeper.cjs)가 하고,
//   여기엔 "언제 어느 객실을 잡아달라"는 요청과 그 결과만 담는다.
//   stayDate 는 체크인일(YYYYMMDD, 1박 고정). 오픈 전이면 WAITING 으로
//   대기하다가 오픈 월요일 10:00 에 러너가 집어간다.
// ⚠️ 이 레포 규칙대로 db push 금지, scripts/ddl-ananti.mjs 수동 DDL.
model AnantiRequest {
  id        String   @id @default(cuid())
  platform  String   // 'chord'(가평) | 'cove'(부산)
  roomName  String   // 객실 카드 라벨 그대로. 예) 더 하우스 확장 (킹2+트윈)
  stayDate  String   // 체크인 YYYYMMDD (1박)
  source    String   @default("manual") // manual | sweep
  status    String   @default("WAITING") // WAITING | BOOKED | EXPIRED | CANCELLED
  folio     String?  // 예약번호
  amount    Int?     // 결제 금액(원)
  lastError String?
  attempts  Int      @default(0)
  lastTryAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, roomName, stayDate])
  @@index([status, stayDate])
}

model AnantiConfig {
  id            Int      @id @default(1)
  sweepEnabled  Boolean  @default(false)
  sweepPlatform String   @default("chord")
  sweepRoom     String   @default("더 하우스 확장 (킹2+트윈)")
  updatedAt     DateTime @updatedAt
}
